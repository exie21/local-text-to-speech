# Copy to .env in the project root. Native services work with these defaults.
# Relative backend paths resolve against the project root, regardless of cwd.
MODEL_DIR=models
TEMP_DIR=data/temp
DATABASE_DIR=data/database

# Kokoro defaults to the versioned filenames in MODEL_DIR.
# Uncomment only to use different files; relative overrides use project root.
# KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=models/voices-v1.0.bin
TTS_THREADS=2
TTS_CHUNK_SIZE=800
MAX_TEXT_CHARS=100000
MAX_UPLOAD_BYTES=10000000

# Used only by the native Vite server; never sent to the browser.
# Compose supplies its own internal backend URL.
API_PROXY_TARGET=http://127.0.0.1:8000

# Compose host ports only. Native launch ports are set in the README commands.
FRONTEND_PORT=5173
BACKEND_PORT=8000
